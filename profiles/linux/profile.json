{
  "from": "none",
  "platform": "linux",
  "shell": "bash",
  "meta": true,
  "paths": {
    "scripts/*": "~/.local/bin/",
    "etc/*": {
      "path": "/etc/*",
      "owner": "root"
    },
    "env": {
      "strategy": "concatenate"
    },
    "bash/*": {
      "strategy": "concatenate"
    },
    "bash/bashrc": {
      "path": "~/.bashrc"
    },
    "bash/profile": {
      "path": "~/.bash_profile"
    }
  }
}
