[core]
    # Defaults to XDG or ~/.config/git/
    # excludesfile = ~/.config/git/ignore
    # attributesFile = ~/.config/git/attributes
[init]
    defaultBranch = main
[user]
    name = Mattia Marchesini
    email = mattia.marchesini1999@gmail.com
[difftool]
    prompt = true
[difftool "vscode_diff"]
    cmd = code --wait --diff $LOCAL $REMOTE
[mergetool]
    prompt = true
[mergetool "vscode_merge"]
    cmd = code --wait $MERGED
[gui]
    encoding = utf-8

[include]
    path = local_config
[includeIf "gitdir:~/Documents/git/work/"]
    path = work_config