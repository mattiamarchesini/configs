{
  //   FILES
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.simpleDialog.enable": true,
  //   SEARCH
  "search.quickOpen.includeHistory": false,
  "search.exclude": {
    "**/.dart_tool": true,
    "**/.ipynb_checkpoints": true,
    "**/env": true,
    "**/.metadata": true
  },
  //   WORKBENCH
  "workbench.startupEditor": "none",
  "workbench.editor.enablePreview": false,
  // needed for extension cweijan.vscode-office
  "workbench.editorAssociations": {
    "*.md": "default",
    "*.markdown": "default"
  },
  //   EDITOR
  "editor.minimap.enabled": false,
  "editor.autoIndent": "advanced",
  "editor.insertSpaces": true,
  "editor.suggestSelection": "first",
  "editor.quickSuggestions": {
    "other": "off",
    "comments": "off",
    "strings": "off"
  },
  "editor.rulers": [ 100 ],
  "editor.renderWhitespace": "all",
  "editor.renderControlCharacters": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.formatOnSave": false,
  "editor.linkedEditing": true,
  "editor.detectIndentation": true,
  "editor.suggest.localityBonus": true,
  "editor.stickyScroll.enabled": false,
  "editor.unicodeHighlight.invisibleCharacters": true,
  "editor.unicodeHighlight.nonBasicASCII": false,
  "editor.unicodeHighlight.includeComments": true,
  //"editor.cursorSurroundingLines": 1000,
  "editor.smoothScrolling": true,
  "editor.experimentalGpuAcceleration": "off",
  //   WINDOW
  "window.openFoldersInNewWindow": "off",
  "window.newWindowDimensions": "maximized",
  "window.restoreFullscreen": true,
  //   EXPLORER
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  //   TERMINAL
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.stickyScroll.enabled": false,
  //   COPILOT, CHAT & MCP
  // you can toggle with alt+\
  "github.copilot.inlineSuggest.enabled": false,
  "chat.instructionsFilesLocations": {
    ".github/instructions": true,
    //"/tmp/postman-collections-post-response.instructions.md": true
    "~/Documents/git/mattia/mcp-instructions": true
  },
  //   GIT
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.defaultCloneDirectory": "~/Documents/git",
  "github.gitProtocol": "ssh",
  //   JIRA & BITBUCKET
  //"atlascode.bitbucket.enabled": true,
  //"atlascode.jira.enabled": true,
  //   SPELLRIGHT
  "spellright.configurationScope": "user",
  "spellright.language": [
    "en",
    "it"
  ],
  "spellright.documentTypes": [
    "latex",
    "markdown",
    "text",
    "yaml",
    "plaintext"
  ],
  "spellright.ignoreFiles": [
    "**/.gitignore",
    "**/.spellignore",
    "**/.vscode/"
  ],
  "spellright.ignoreRegExps": [ ],
  "spellright.notificationClass": "hint",
  //   SETTINGSSYNC
  "settingsSync.ignoredSettings": [
    "yaml.schemas"
  ],
  "settingsSync.keybindingsPerPlatform": false,
  //   TODOTREE
  "todo-tree.general.tags": [
    "BUG",
    "HACK",
    "FIXME",
    "TODO",
    "XXX",
    "[ ]",
    "[x]"
  ],
  "todo-tree.regex.regex": "(//|#|<!--|;|/\\*|^|^\\s*(-|\\d+.))\\s*($TAGS): ",
  //   ZEN MODE
  "zenMode.hideLineNumbers": false,
  "zenMode.fullScreen": false,
  //   ERROR LENS
  "errorLens.enabledDiagnosticLevels": [
    "warning",
    "info",
    "error",
    "hint"
  ],
  "errorLens.enabled": false,
  //   LANGUAGE-SPECIFIC SETTINGS
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[dockercompose]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  //
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "json.format.keepLines": true,
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  //
  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml"
  },
  //
  "[markdown]": {
    "editor.defaultFormatter": "vscode.markdown-language-features"
  },
  "markdown.updateLinksOnFileMove.enabled": "always",
  "reflowMarkdown.preferredLineLength": 100, // count may be a little broken
  //
  "[python]": { },
  "python.analysis.persistAllIndices": false,
  "python.createEnvironment.trigger": "off",
  "python.analysis.autoImportCompletions": true,
  "python.createEnvironment.contentButton": "show",
  //
  "telemetry.telemetryLevel": "off",
  "redhat.telemetry.enabled": false,
  "color-highlight.markerType": "dot-before",
  "testExplorer.useNativeTesting": true,
  "security.workspace.trust.enabled": false,
  "dev.containers.executeInWSL": true,
  "hediet.vscode-drawio.resizeImages": null
  // "http.systemCertificatesNode": true // needed for gemini code assist
}